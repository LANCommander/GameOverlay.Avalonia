<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GameOverlay.Linux.AvaloniaHost</AssemblyName>
    <RootNamespace>GameOverlay.Linux.AvaloniaHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\GameOverlay.Avalonia\GameOverlay.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Linux Avalonia platform + a bundled font, which the overlay library
         deliberately does not bring itself. -->
    <PackageReference Include="Avalonia.X11" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
  </ItemGroup>

</Project>
